{
    "name": "aicrion/ir-currency-rate-scraper",
    "description": "A modern, resilient PHP 7.4+ library for scraping and aggregating Iranian currency, gold, coin, and crypto rates.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "currency",
        "rate",
        "scraper",
        "iran",
        "rial",
        "toman",
        "gold",
        "coin",
        "crypto",
        "tgju",
        "arzdigital"
    ],
    "authors": [
        {
            "name": "Hadi Akbarzadeh",
            "email": "elsiomcoder@gmail.com",
            "homepage": "https://elatel.ir",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-json": "*",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "symfony/dom-crawler": "^5.4 || ^6.4 || ^7.0",
        "symfony/css-selector": "^5.4 || ^6.4 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "phpstan/phpstan": "^1.11",
        "friendsofphp/php-cs-fixer": "^3.50",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/simple-cache": "^1.0 || ^2.0 || ^3.0"
    },
    "suggest": {
        "psr/http-client": "Allows injecting custom PSR-18 HTTP clients (e.g. Guzzle, Symfony HttpClient)",
        "psr/http-factory": "Allows creating PSR-7 requests/responses",
        "psr/simple-cache": "Allows adapting any PSR-16 cache implementation (e.g. Redis, Symfony Cache, Laravel Cache)"
    },
    "autoload": {
        "psr-4": {
            "Aicrion\\IrCurrencyRateScraper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aicrion\\IrCurrencyRateScraper\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse",
        "cs:check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs:fix": "vendor/bin/php-cs-fixer fix"
    },
    "bin": [
        "bin/currency"
    ],
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
